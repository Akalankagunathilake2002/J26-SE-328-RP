# Where the Next.js server reaches the backend (the API gateway).
API_GATEWAY_URL=http://localhost:8080

# Interview recordings saved to the candidate's own Google Drive (optional; without it, recordings can only
# be downloaded). An OAuth 2.0 "Web application" client ID from Google Cloud Console, with the Google Drive
# API enabled and this site's origin under "Authorised JavaScript origins". Only the drive.file scope is used.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
