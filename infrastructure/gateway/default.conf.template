# API gateway: the single entry point to the backend microservices.
#
# Each service gets its own location block below. Service names are resolved through Docker's
# DNS when a request arrives, so the gateway starts even if a service is down; that service's
# routes return 503 until it is back.

resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    default_type application/json;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;

    client_max_body_size 50M;

    # Global CORS Headers for API calls
    add_header 'Access-Control-Allow-Origin' '*' always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
    add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;
    add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;

    error_page 502 503 504 = @service_unavailable;

    location = /health {
        return 200 '{"status":"healthy","service":"api-gateway"}';
    }

    # auth-service: accounts, login and the current user. API docs at /auth/docs.
    location /auth/ {
        set $auth_service http://auth-service:8006;
        proxy_pass $auth_service;
    }

    location = /auth/health {
        set $auth_service http://auth-service:8006;
        proxy_pass $auth_service/health;
    }

    location /ssks/ {
        set $shared_skill_knowledge http://shared-skill-knowledge:${SHARED_SKILL_KNOWLEDGE_PORT};
        proxy_pass $shared_skill_knowledge;
    }

    # RAG: Learning Microservice
    location /api/v1/learning/ {
        if ($request_method = 'OPTIONS') {
            return 204;
        }
        set $learning_service http://learning-service:${LEARNING_SERVICE_PORT};
        proxy_pass $learning_service;
        proxy_read_timeout 120s;
    }

    location /api/v1/progress/ {
        if ($request_method = 'OPTIONS') {
            return 204;
        }
        set $learning_service http://learning-service:${LEARNING_SERVICE_PORT};
        proxy_pass $learning_service;
    }

    location /api/v1/research/ {
        if ($request_method = 'OPTIONS') {
            return 204;
        }
        set $learning_service http://learning-service:${LEARNING_SERVICE_PORT};
        proxy_pass $learning_service;
        proxy_read_timeout 120s;
    }

    # RAG: AI Mock Interview Microservice
    location /api/v1/interview/ {
        if ($request_method = 'OPTIONS') {
            return 204;
        }
        set $interview_service http://interview-service:${INTERVIEW_SERVICE_PORT};
        proxy_pass $interview_service;
        proxy_read_timeout 180s;
    }

    location @service_unavailable {
        return 503 '{"detail":"Service unavailable"}';
    }

    location / {
        return 404 '{"detail":"Not found"}';
    }
}
